# GUI-AX Framework — environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored; this file is committed as a template.

# ─────────────────────────────────────────────────────────────────────────────
# AI (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API key — leave blank to disable the AI panel entirely.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Flask bridge
# ─────────────────────────────────────────────────────────────────────────────
# Port the Python bridge listens on. The React UI talks to this.
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Paths (all optional — defaults are relative to the repo root)
# ─────────────────────────────────────────────────────────────────────────────
# Path to the persistent JSON data store.
# STORE_PATH=./data/axiom_bridge_store.json

# Directory the bridge watches for new scan output to import.
# IMPORTS_PATH=./imports
