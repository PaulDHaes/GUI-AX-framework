# GUI-AX Framework — environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored; this file is committed as a template.

# ─────────────────────────────────────────────────────────────────────────────
# AI (optional — local deterministic analysis always works without any key)
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama / LiteLLM (recommended — all data stays on your machine) ───────────
# Point OLLAMA_URL at wherever Ollama or a LiteLLM proxy is running.
#
#   Ollama on your Mac (accessed from inside Docker):
OLLAMA_URL=http://host.docker.internal:11434
#
#   LiteLLM proxy on another host (multi-GPU server, etc.):
#   OLLAMA_URL=http://192.168.1.50:4000
#
#   Ollama on the same bare-metal host (not inside Docker):
#   OLLAMA_URL=http://localhost:11434

# Model name as known to your Ollama/LiteLLM instance:
OLLAMA_MODEL=llama3.2

# ── Claude API (optional — sends prompts to Anthropic servers) ────────────────
# "auto" mode prefers Ollama → Claude → local fallback.
# Only use for non-confidential work. Get a key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-…

# Override the default Claude model (optional):
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────────────────────
# Flask bridge
# ─────────────────────────────────────────────────────────────────────────────
# Port the Python bridge listens on. The React UI talks to this.
PORT=5000

# Bind address. 0.0.0.0 exposes the bridge on all interfaces (required in
# Docker). Use 127.0.0.1 to restrict to localhost only on bare-metal installs.
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (optional — docker-compose reads these from .env)
# ─────────────────────────────────────────────────────────────────────────────
# Leave GUI_AX_PASSWORD blank to run the dashboard with no login gate.
# Set a real password to enable it. Never commit real values — keep them in .env.
GUI_AX_USERNAME=admin
GUI_AX_PASSWORD=

# Optional stable Flask session key so browser sessions survive a bridge
# restart. Without this a random key is generated on every start (all open
# sessions are invalidated on restart).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GUI_AX_SECRET_KEY=

# Optional static token so browser sessions survive a bridge restart.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GUI_AX_STATIC_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Paths (all optional — defaults are relative to the repo root)
# ─────────────────────────────────────────────────────────────────────────────
# Path to the persistent JSON data store.
# STORE_PATH=./data/axiom_bridge_store.json

# Directory the bridge watches for new scan output to import.
# IMPORTS_PATH=./imports

# Override the Ax framework home directory (default: ~/.axiom or /root/.axiom
# inside the Docker container).
# AXIOM_HOME=/root/.axiom

# ─────────────────────────────────────────────────────────────────────────────
# Geo Map — offline IP geolocation (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Path to a MaxMind GeoLite2-City database. When present (and the geoip2 lib is
# installed), the Geo Map can geolocate host IPs offline — no IPs leave the box.
# Free download: https://www.maxmind.com/en/geolite2/signup
# GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# ─────────────────────────────────────────────────────────────────────────────
# Performance tuning (all optional)
# ─────────────────────────────────────────────────────────────────────────────
# How often (seconds) the bridge re-scans imports/ for new files.
# Lower values mean faster auto-import; higher values reduce disk I/O.
# WATCHER_INTERVAL=300

# How long (seconds) fleet instance data is cached before the bridge re-queries
# the cloud provider. Lower = more current; higher = fewer API calls.
# FLEET_CACHE_TTL=30

# Directory used for per-workflow step logs created by workflow-runner.py.
# WF_LOG_DIR=/tmp/workflow-logs

# ─────────────────────────────────────────────────────────────────────────────
# AWS / cloud provider (Docker-only — set excluded regions to avoid IAM denies)
# ─────────────────────────────────────────────────────────────────────────────
# Space-separated list of AWS region names that the aws wrapper (installed by
# tools/setup-aws-region-filter.sh) will skip entirely — useful when your IAM
# policy explicitly denies certain regions (e.g. Middle-East/IL).
# AXIOM_EXCLUDED_REGIONS=me-south-1 me-central-1 il-central-1

# ─────────────────────────────────────────────────────────────────────────────
# MCP server (tools/mcp-server.py — only needed when running the server
# manually outside the Docker container or the Settings UI toggle)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the bridge the MCP server talks to (default: http://localhost:5000).
# GUIAX_BRIDGE_URL=http://localhost:5000

# Authenticate the MCP server as a specific user. Use either a static token
# or username + password (token takes precedence).
# GUIAX_TOKEN=
# GUIAX_USERNAME=
# GUIAX_PASSWORD=

# Default AWS region for MCP-initiated scans (optional).
# GUIAX_DEFAULT_REGION=us-east-1

# Maximum number of fleet instances the MCP server may spin up per call.
# GUIAX_MAX_INSTANCES=5

# Bind host / port for the MCP server when running in streamable-HTTP mode.
# GUIAX_MCP_HOST=127.0.0.1
# GUIAX_MCP_PORT=8787
